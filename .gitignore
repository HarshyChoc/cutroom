# Dependencies and local build caches
node_modules/
.whisper/
.remotion/
.venv/
__pycache__/
.pytest_cache/
*.tsbuildinfo
*.log
.DS_Store
._*

# Local credentials and agent preferences
.env
.env.*
!.env.example
!.env.*.example
.claude/settings.json
.claude/settings.local.json

# Media, transcripts, edit plans, and render state stay local.
# Keep public examples outside content/; never force-add customer media.
content/library/
content/output/
content/raw/*
!content/raw/.gitkeep
content/assets/*
!content/assets/music/
content/assets/music/*
!content/assets/music/.gitkeep
